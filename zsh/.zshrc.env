# Plugins
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
#export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#ff00ff,bg=cyan,bold,underline"

# Environment

# Run the user's editor for sudoedit; do not assume a package-manager prefix.
if [[ -z "${SUDO_EDITOR:-}" ]]; then
	for _dotfiles_editor in "${VISUAL:-}" "${EDITOR:-}" nvim vim vi; do
		[[ -n "${_dotfiles_editor}" ]] || continue
		if [[ "${_dotfiles_editor}" == */* ]]; then
			[[ -x "${_dotfiles_editor}" ]] || continue
			SUDO_EDITOR="${_dotfiles_editor}"
		else
			(( $+commands[${_dotfiles_editor}] )) || continue
			SUDO_EDITOR="${commands[${_dotfiles_editor}]}"
		fi
		break
	done
fi
[[ -n "${SUDO_EDITOR:-}" ]] && export SUDO_EDITOR

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [[ -d "$HOME/Documents/MATLAB" ]]; then
	export MATLAB="${MATLAB:-$HOME/Documents/MATLAB}"
fi
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

# Let Julia pick the thread count from the host instead of hardcoding 8, which
# was wrong on any machine with a different core count.
export JULIA_NUM_THREADS="${JULIA_NUM_THREADS:-auto}"

# Resolve the active JDK dynamically. The previous hardcoded corretto-23 path
# did not exist, which silently broke every tool that reads JAVA_HOME
# (maven/gradle/sbt); `java` itself only worked via the /usr/bin/java stub.
if [[ "${DOTFILES_PLATFORM}" == macos && -z "${JAVA_HOME:-}" && -x /usr/libexec/java_home ]]; then
	JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null)"
	[[ -z "$JAVA_HOME" ]] && unset JAVA_HOME
elif [[ "${DOTFILES_PLATFORM}" == linux && "${OSTYPE:-}" == linux* && -z "${JAVA_HOME:-}" ]] && (( $+commands[java] )) && (( $+commands[readlink] )); then
	_dotfiles_java_bin="${commands[java]}"
	_dotfiles_java_real="$(readlink -f "${_dotfiles_java_bin}" 2>/dev/null || true)"
	if [[ "${_dotfiles_java_real}" == */bin/java ]]; then
		JAVA_HOME="${_dotfiles_java_real:h:h}"
		[[ -d "$JAVA_HOME" ]] || unset JAVA_HOME
	fi
fi

# PATH (path_prepend from .zshenv skips directories that do not exist)
# Guarded: an empty JAVA_HOME would make this "/bin", which exists and would
# wrongly jump to the front of PATH.
[[ -n "$JAVA_HOME" ]] && path_prepend "$JAVA_HOME/bin"
path_prepend "$HOME/src/scripts"

# pnpm
if [[ -z "${PNPM_HOME:-}" ]]; then
	if [[ "${DOTFILES_PLATFORM}" == macos ]]; then
		PNPM_HOME="$HOME/Library/pnpm"
	else
		PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
	fi
fi
export PNPM_HOME
path_prepend "$PNPM_HOME"

# Browser-dependent tooling. Prefer an explicit override, then discover a
# browser available on the current host.
if [[ -z "${PUPPETEER_EXECUTABLE_PATH:-}" ]]; then
	if [[ "${DOTFILES_PLATFORM}" == macos && -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]]; then
		PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
	else
		for _dotfiles_browser in google-chrome chromium chromium-browser; do
			if (( $+commands[${_dotfiles_browser}] )); then
				PUPPETEER_EXECUTABLE_PATH="${commands[${_dotfiles_browser}]}"
				break
			fi
		done
	fi
fi
[[ -n "${PUPPETEER_EXECUTABLE_PATH:-}" ]] && export PUPPETEER_EXECUTABLE_PATH

unset _dotfiles_editor _dotfiles_java_bin _dotfiles_java_real _dotfiles_browser
