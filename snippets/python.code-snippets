	"Energy level diagram": {
		"scope": "python,jupyter-notebook",
		"prefix": "levels",
		"body": [
			"fig, ax = plt.subplots()",
			"",
			"for i, E in enumerate(${1:levels}):",
			"    ax.hlines(E, 0, 1, color=f\"C{i}\")",
			"    ax.text(0.5, E, f\"$E_{i}$\", ha=\"center\", va=\"bottom\")",
			"",
			"ax.set_xlim(-0.1, 1.1)",
			"ax.set_xlabel(\"\")",
			"ax.set_ylabel(\"Energy\")",
			"ax.set_title(\"Energy Levels\")",
			"",
			"plt.show()"
		],
		"description": "[绘图] 能级图（原子/分子能级）"
	},
	"Energy transition diagram": {
		"scope": "python,jupyter-notebook",
		"prefix": "transition",
		"body": [
			"fig, ax = plt.subplots()",
			"",
			"ax.hlines(${1:E1}, 0, 1)",
			"ax.hlines(${2:E2}, 0, 1)",
			"",
			"ax.annotate(\"\", xy=(0.5, ${2:E2}), xytext=(0.5, ${1:E1}),",
			"            arrowprops=dict(arrowstyle=\"->\"))",
			"",
			"plt.show()"
		],
		"description": "[绘图] 能级跃迁"
