			"@njit(cached=True)",
			"def ${1:name}(${2:args}):",
			"    ${0:pass}"
		],
		"description": "[Numba] Numba JIT 编译函数"
	},
	"Numba parallel loop": {
		"scope": "python,jupyter-notebook",
		"prefix": "pjnjit",
		"body": [
			"from numba import njit, prange",
			"",
			"@njit(parallel=True)",
			"def ${1:name}(${2:n}):",
			"    for i in prange(${2:n}):",
			"        ${0:pass}"
		],
		"description": "[Numba] Numba 并行循环"
	},
