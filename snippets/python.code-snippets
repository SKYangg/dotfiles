	"Simple function": {
		"scope": "python,jupyter-notebook",
		"prefix": "df",
		"body": [
			"def ${1:name}(${2:args}):",
			"    ${0:pass}"
		],
		"description": "[基础] 简单函数定义"
	},
	"Scientific function": {
		"scope": "python, jupyter-notebook",
		"prefix": "defn",
		"body": [
			"def ${1:name}(${2:args}) -> ${3:None}:",
			"    \"\"\"${4:Description}.",
			"",
			"    Parameters",
			"    ----------",
			"    ${5:param} : ${6:type}",
			"        ${7:Parameter description}",
			"",
			"    Returns",
			"    -------",
			"    ${8:type}",
			"        ${9:Return description}",
			"    \"\"\"",
			"    ${0:pass}"
		],
		"description": "[基础] 科学计算函数（带 NumPy 风格文档字符串）"
	},
	"Class": {
		"scope": "python,jupyter-notebook",
		"prefix": "cls",
		"body": [
			"class ${1:ClassName}:",
			"    \"\"\"${2:Description}.\"\"\"",
			"",
			"    def __init__(self, ${3:args}):",
			"        ${0:pass}"
		],
		"description": "[基础] 类定义模板"
	},
	"Dataclass": {
		"scope": "python,jupyter-notebook",
		"prefix": "dcls",
		"body": [
			"from dataclasses import dataclass",
			"",
			"@dataclass",
			"class ${1:ClassName}:",
			"    ${2:field}: ${3:type}"
		],
		"description": "[基础] dataclass（Python 3.7+）"
	},
