	"Contour phase diagram": {
		"scope": "python,jupyter-notebook",
		"prefix": "phasec",
		"body": [
			"fig, ax = plt.subplots()",
			"",
			"cs = ax.contour(${1:X}, ${2:Y}, ${3:Z})",
			"",
			"ax.clabel(cs)",
			"",
			"plt.show()"
		],
		"description": "[绘图] 等高线相图"
