[user]
	name = YOUR_NAME
	email = your.email@example.com
	signingkey = ~/.ssh/your_signing_key

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignerFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[safe]
	directory = *

[core]
	editor = vim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	features = side-by-side line-numbers decorations

[merge]
	conflictStyle = zdiff3
